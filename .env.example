# Firebase Configuration
# Copy this file to .env and fill in your Firebase project details
# DO NOT commit .env file to version control

# Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Firebase API Key
FIREBASE_API_KEY=your-api-key

# Firebase App ID
FIREBASE_APP_ID=your-app-id

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# College Email Domain (without @)
ALLOWED_EMAIL_DOMAIN=@galgotiasuniversity.edu.in

# Note: After running 'flutterfire configure', most of these values
# will be automatically generated in lib/firebase_options.dart
