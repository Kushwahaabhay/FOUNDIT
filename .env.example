# FOUNDIT Environment Variables
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values below
# 3. NEVER commit .env to version control!
#
# See SETUP_INSTRUCTIONS.md for detailed configuration guide.

# ============================================
# CLOUDINARY CONFIGURATION
# Get from: https://console.cloudinary.com/
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=foundit_preset

# ============================================
# GOOGLE OAUTH
# Get from: https://console.cloud.google.com/apis/credentials
# ============================================
GOOGLE_WEB_CLIENT_ID=your_client_id.apps.googleusercontent.com

# ============================================
# FIREBASE - WEB CONFIGURATION
# Get from: Firebase Console > Project Settings > Web App
# ============================================
FIREBASE_WEB_API_KEY=AIzaSy...
FIREBASE_WEB_APP_ID=1:xxxx:web:xxxx
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=xxxx

# ============================================
# FIREBASE - ANDROID CONFIGURATION  
# Get from: Firebase Console > Project Settings > Android App
# ============================================
FIREBASE_ANDROID_API_KEY=AIzaSy...
FIREBASE_ANDROID_APP_ID=1:xxxx:android:xxxx

# ============================================
# NOTES
# ============================================
# - All values starting with 'your_' or 'xxxx' must be replaced
# - Firebase API keys are safe for client-side use (security via Firestore rules)
# - Cloudinary unsigned preset is designed for client-side uploads
# - See TROUBLESHOOTING.md if you encounter issues
