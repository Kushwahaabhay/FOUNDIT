# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# Environment variables - NEVER commit these!
.env
.env.local
.env.*.local

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase (keep google-services.json local only)
google-services.json
.firebase/
.firebaserc
firebase.json
firestore.indexes.json
firestore.rules

# Environment variables
.env
.env.local
.env.*.local
.env.production
.env.development

# Sensitive configuration files (should be generated locally)
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
web/firebase-config.js
web/index.html

# Local configuration files
config.local.dart
secrets.local.dart

# API Keys and secrets
**/api_keys.dart
**/secrets.dart
**/config.dart

# Keystore files
*.jks
*.keystore
key.properties

